 struct PalmProposal {
     roi: Roi,
     landmarks: [XY; 7],
 }
+/// Refresh only mutual unique matches; a plausible alternate is not identity.
+fn palm_refresh_matches(tracks: &[TrackedHand], proposals: &[PalmProposal]) -> Vec<Option<usize>> {
+    let costs: Vec<Vec<bool>> = tracks
+        .iter()
+        .map(|track| {
+            proposals
+                .iter()
+                .map(|p| palm_match_cost(&track.hand, &p.landmarks).is_some_and(|c| c < 0.25))
+                .collect()
+        })
+        .collect();
+    costs
+        .iter()
+        .map(|row| {
+            let matches: Vec<_> = row
+                .iter()
+                .enumerate()
+                .filter(|(_, yes)| **yes)
+                .map(|(i, _)| i)
+                .collect();
+            if matches.len() != 1 {
+                return None;
+            }
+            let p = matches[0];
+            (costs.iter().filter(|r| r[p]).count() == 1).then_some(p)
+        })
+        .collect()
+}
